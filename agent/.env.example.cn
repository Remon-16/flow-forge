# ================================================================
# Flow Forge — 环境变量配置
# ================================================================
# 复制此文件为 .env 并修改配置：
#   cp .env.example.cn .env
# 英文版配置模板请参见 .env.example.en
# ================================================================

# --- LLM 供应商配置 ---
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
# LLM Base URL（OpenAI 留空；第三方 API 参考以下示例）
# DeepSeek: https://api.deepseek.com
# GLM:     https://open.bigmodel.cn/api/paas/v4
# Ollama:  http://localhost:11434/v1
LLM_BASE_URL=

# LLM 上下文窗口（默认 128000 token）
# 根据所用模型的实际窗口设置（如 8192, 32768, 128000, 1048576）。
# 智能体据此判断何时拆分长文本或压缩对话历史。
LLM_CONTEXT_WINDOW=128000

# 上下文压缩阈值（默认 0.9）
# 当输入 token 超过 上下文窗口 × 此阈值 时触发压缩。
# 按模型微调：
#   - 推理模型（o1, deepseek-r1）: 0.95（为链式思维留更大余量）
#   - 小窗口模型（8K）: 0.8（更积极地压缩）
LLM_CONTEXT_COMPRESSION_THRESHOLD=0.9

# 单次最大输出 token（默认 4096）
# 替代旧版 LLM_MAX_TOKENS。如两者同时设置，LLM_MAX_OUTPUT_TOKENS 优先。
LLM_MAX_OUTPUT_TOKENS=4096

# --- 知识库（基于 grep 的纯文本搜索，无需 embedding）---
ENABLE_KNOWLEDGE=false
KNOWLEDGE_DIR=./knowledge

# 文档解析（传入 LLM 的 API 文档最大字符数，按模型窗口调整）
# 8K 模型: 2000 | 128K 模型: 30000（默认）| 1M+ 模型: 100000

# --- 流水线设置 ---
MAX_STEPS=10
MAX_RETRIES=3

# --- 频率限制 — 控制请求频率，避免 429 错误 ---
# LLM_RATE_LIMIT_DELAY: 每次 LLM 调用最低间隔（秒，默认 0 = 不限）
#   GLM 免费模型建议 3.0–5.0 秒
LLM_RATE_LIMIT_DELAY=0.0
# LLM_RETRY_BASE_DELAY: 固定延迟重试的基础秒数（默认 2.0）
#   每次重试等待此固定时长（不增长）。
#   以 max_retries=3 为例：3 次重试 × 每次 base_delay 秒。
LLM_RETRY_BASE_DELAY=2.0
# LLM_MAX_CONCURRENCY: 最大并发请求数（默认 1）
#   GLM 免费模型严格限制 1 并发。设为 0 取消限制（仅付费套餐使用）。
LLM_MAX_CONCURRENCY=1
# LLM_REQUEST_TIMEOUT: HTTP 请求超时秒数（连接 + 读取，默认 600 = 10分钟）
#   OpenAI SDK 底层 httpx 默认 600 秒。此超时包含连接建立、发送请求、
#   等待 LLM 服务端处理、接收响应的总时间。如果服务端不稳定或网络质量差，
#   建议降到 60-120 秒。注意：设置过短可能导致长时间推理被提前中断。
LLM_REQUEST_TIMEOUT=600.0
# CONSECUTIVE_BATCH_FAILURE_LIMIT: 连续 N 个 batch 失败后停止（默认 3, -1=永不停止）
#   当批量处理（数据填充/断言生成/插件执行）中连续多个 batch 失败时停止，
#   避免在限流或服务异常时浪费时间和配额。
CONSECUTIVE_BATCH_FAILURE_LIMIT=3

# --- 输出设置 ---
# 输出根目录。运行时会自动追加时间戳（如 ./output_20260622_143052），
# 除非通过 --output 显式指定。
# 目录结构：
#   {output_dir}/
#     cases/              # 测试用例产物（YAML 文件 + 可选 Excel）
#     memory/             # 智能体输出（plan.md + snapshots/）
#       snapshots/        # 流水线中间状态快照
OUTPUT_DIR=./output
BATCH_SIZE=10
ENABLE_VALIDATION=true
MAX_VALIDATION_RETRIES=3
# yaml = 仅 YAML | excel = 仅 Excel | both = YAML + Excel
OUTPUT_FORMAT=both

# --- 插件系统 ---
# 以下为官方提供的插件，用户可自由增删：
#   • 数据填充: plugins.official.data_filling.DataFillingPlugin
#   • 断言生成: plugins.official.assertion_generation.AssertionGenerationPlugin
# 设为 false 则跳过所有插件执行。
ENABLE_PLUGINS=true
# 逗号分隔的模块路径，按声明顺序执行。用户可替换为自定义插件。
# 示例（4 种典型自定义插件）：
#   PLUGIN_MODULES=my_plugins.single_pre_processor.SinglePreProcessor,my_plugins.single_post_processor.SinglePostProcessor,my_plugins.biz_pre_processor.BizPreProcessor,my_plugins.biz_post_processor.BizPostProcessor
PLUGIN_MODULES=plugins.official.data_filling.DataFillingPlugin,plugins.official.assertion_generation.AssertionGenerationPlugin

# --- 界面语言（默认 zh_CN，可选 en_US）---
AGENT_LANG=zh_CN
