# LLM Provider Configuration
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
# LLM Base URL (leave empty for OpenAI; set for other providers)
# DeepSeek: https://api.deepseek.com
# GLM:     https://open.bigmodel.cn/api/paas/v4
# Ollama:  http://localhost:11434/v1
LLM_BASE_URL=

# Knowledge Base (grep-based text search, no embedding required)
ENABLE_KNOWLEDGE=false
KNOWLEDGE_DIR=./knowledge

# Document Parsing (max chars sent to LLM for API doc parsing; adjust based on model context)
# 8K models: 2000 | 128K models: 30000 (default) | 1M+ models: 100000
LLM_DOC_MAX_CHARS=30000

# Pipeline Settings
MAX_STEPS=10
MAX_RETRIES=3

# Output Settings
# Root output directory. At runtime the CLI appends a timestamp (e.g. ./output_20260619_143052)
# unless --output is explicitly provided.
# Output structure:
#   {output_dir}/
#     cases/              # Test case artifacts (YAML files + optional Excel)
#     memory/             # Agent output files (plan.md + snapshots/)
#       snapshots/        # Pipeline intermediate state snapshots
OUTPUT_DIR=./output
BATCH_SIZE=10
ENABLE_VALIDATION=true
MAX_VALIDATION_RETRIES=3
# yaml = YAML files only | excel = Excel only | both = YAML + Excel
OUTPUT_FORMAT=both

# Plugin System — Custom Case-Attribute Generators
# Enable plugins that run after assertion generation to add custom attributes
# (e.g. preprocessors, postprocessors) to generated test cases.
ENABLE_PLUGINS=false
# Comma-separated dotted module paths, executed in order.
# Example (4 typical plugin types):
#   PLUGIN_MODULES=my_plugins.single_pre_processor.SinglePreProcessor,my_plugins.single_post_processor.SinglePostProcessor,my_plugins.biz_pre_processor.BizPreProcessor,my_plugins.biz_post_processor.BizPostProcessor
PLUGIN_MODULES=
