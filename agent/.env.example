# LLM Provider Configuration
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# Knowledge Base (grep-based text search, no embedding required)
ENABLE_KNOWLEDGE=false
KNOWLEDGE_DIR=./knowledge

# Pipeline Settings
MAX_STEPS=10
MAX_RETRIES=3
