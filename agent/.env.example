# LLM Provider Configuration
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096

# Embedding Model (for RAG)
EMBEDDING_MODEL=text-embedding-3-small

# Knowledge Base
KNOWLEDGE_DB_PATH=./chroma_data

# Pipeline Settings
MAX_STEPS=10
MAX_RETRIES=3
