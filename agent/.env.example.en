# ================================================================
# Flow Forge — Environment Variables Configuration
# ================================================================
# Copy this file to .env and edit the values:
#   cp .env.example.en .env
# For a Chinese version, see .env.example.cn
# ================================================================

# --- LLM Provider Configuration ---
LLM_PROVIDER=openai
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
# LLM Base URL (leave empty for OpenAI; set for other providers)
# DeepSeek: https://api.deepseek.com
# GLM:     https://open.bigmodel.cn/api/paas/v4
# Ollama:  http://localhost:11434/v1
LLM_BASE_URL=

# LLM Context Window (default: 128000 tokens)
# Set this to match your model's actual context window (e.g. 8192, 32768, 128000, 1048576).
# The agent uses this value to decide when to split long text into chunks
# and when to compress conversation history.
LLM_CONTEXT_WINDOW=128000

# Context Compression Threshold (default: 0.9)
# When input tokens exceed this fraction of the context window, the agent
# triggers context compression. Adjust based on your model:
#   - Reasoning models (o1, deepseek-r1): 0.95 (larger margin for chain-of-thought)
#   - Small-window models (8K): 0.8 (more aggressive compression)
LLM_CONTEXT_COMPRESSION_THRESHOLD=0.9

# Max Output Tokens per call (default: 4096)
# Replaces the older LLM_MAX_TOKENS. If LLM_MAX_OUTPUT_TOKENS is set it takes
# precedence; otherwise falls back to LLM_MAX_TOKENS.
LLM_MAX_OUTPUT_TOKENS=4096

# --- Knowledge Base (grep-based text search, no embedding required) ---
ENABLE_KNOWLEDGE=false
KNOWLEDGE_DIR=./knowledge

# Document Parsing (max chars sent to LLM for API doc parsing; adjust based on model context)
# 8K models: 2000 | 128K models: 30000 (default) | 1M+ models: 100000

# --- Pipeline Settings ---
MAX_STEPS=10
MAX_RETRIES=3

# --- Rate Limiting — control request frequency to avoid 429 errors ---
# LLM_RATE_LIMIT_DELAY: Minimum seconds between LLM calls (default: 0 = no limit)
#   For free GLM models with strict rate limits, try 3.0–5.0 seconds
LLM_RATE_LIMIT_DELAY=0.0
# LLM_RETRY_BASE_DELAY: Base seconds for fixed-delay retry (default: 2.0)
#   Each retry waits exactly this many seconds (no growth).
#   With max_retries=3: 3 retries × base_delay seconds each.
LLM_RETRY_BASE_DELAY=2.0
# LLM_MAX_CONCURRENCY: Max simultaneous LLM requests (default: 1)
#   Free GLM models have a strict "1 concurrent" limit — the agent will never
#   send a second request before the first completes. Set to 0 to disable
#   (no concurrency limit). Increase only for paid tiers that allow it.
LLM_MAX_CONCURRENCY=1
# LLM_REQUEST_TIMEOUT: HTTP request timeout in seconds (connect + read, default: 600 = 10 min)
#   The OpenAI SDK uses httpx with a default 600-second timeout. This timeout covers
#   connection establishment, sending the request, waiting for the LLM server to process,
#   and receiving the response. If the server is unstable or network quality is poor,
#   consider lowering to 60-120 seconds. Note: setting this too low may cause
#   long-running inference requests to be interrupted prematurely.
LLM_REQUEST_TIMEOUT=600.0
# CONSECUTIVE_BATCH_FAILURE_LIMIT: Stop after N consecutive batch failures (default: 3, -1=never)
#   When multiple consecutive batches fail during batch processing
#   (data filling, assertion generation, plugin execution), the pipeline stops
#   to avoid wasting time and quota on rate-limited or failing services.
CONSECUTIVE_BATCH_FAILURE_LIMIT=3

# --- Output Settings ---
# Root output directory. At runtime the CLI appends a timestamp (e.g. ./output_20260622_143052)
# unless --output is explicitly provided.
# Output structure:
#   {output_dir}/
#     cases/              # Test case artifacts (YAML files + optional Excel)
#     memory/             # Agent output files (plan.md + snapshots/)
#       snapshots/        # Pipeline intermediate state snapshots
OUTPUT_DIR=./output
BATCH_SIZE=10
ENABLE_VALIDATION=true
MAX_VALIDATION_RETRIES=3
# yaml = YAML files only | excel = Excel only | both = YAML + Excel
OUTPUT_FORMAT=both

# --- Plugin System ---
# Official plugins (remove or replace any as needed):
#   • Data Filling:  plugins.official.data_filling.DataFillingPlugin
#   • Assertions:    plugins.official.assertion_generation.AssertionGenerationPlugin
# Set to false to skip all plugin execution.
ENABLE_PLUGINS=true
# Comma-separated dotted module paths, executed in declaration order.
# Example (4 typical user plugins):
#   PLUGIN_MODULES=my_plugins.single_pre_processor.SinglePreProcessor,my_plugins.single_post_processor.SinglePostProcessor,my_plugins.biz_pre_processor.BizPreProcessor,my_plugins.biz_post_processor.BizPostProcessor
PLUGIN_MODULES=plugins.official.data_filling.DataFillingPlugin,plugins.official.assertion_generation.AssertionGenerationPlugin

# --- UI Language (zh_CN / en_US) ---
AGENT_LANG=zh_CN
