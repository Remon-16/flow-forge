{
  "entry": "agent",
  "description_zh": "Flow Forge — API 测试用例生成智能体",
  "description_en": "Flow Forge — API Test Case Generation Agent",
  "flag_style": "kebab-case",
  "args": [
    {
      "flag": "--requirement",
      "short": null,
      "dest": "requirement",
      "type": "str",
      "nargs": "+",
      "default": null,
      "help_zh": "需求文档路径 (.txt, .md, .pdf)",
      "help_en": "Requirement document path(s)",
      "section": null,
      "studio": { "editable": false }
    },
    {
      "flag": "--api",
      "short": null,
      "dest": "api",
      "type": "str",
      "nargs": "+",
      "default": null,
      "help_zh": "API 文档路径（支持多个文件）(OpenAPI .yaml/.json 或 Markdown .md)",
      "help_en": "API documentation path(s)",
      "section": null,
      "studio": { "editable": false }
    },
    {
      "flag": "--output",
      "short": null,
      "dest": "output",
      "type": "str",
      "default": null,
      "help_zh": "输出根目录（默认：./output_<timestamp>）",
      "help_en": "Output root directory (default: ./output_<timestamp>)",
      "section": null,
      "studio": { "editable": false }
    },
    {
      "flag": "--output-format",
      "short": null,
      "dest": "output_format",
      "type": "str",
      "choices": ["yaml", "excel", "both"],
      "default": null,
      "help_zh": "输出格式: yaml, excel, both（默认: both，或取自 env.yaml）",
      "help_en": "Output format: yaml, excel, both (default: both, or from env.yaml)",
      "section": null,
      "studio": { "editable": false }
    },
    {
      "flag": "--debug-snapshots",
      "short": null,
      "dest": "debug_snapshots",
      "type": "bool_store_true",
      "default": false,
      "help_zh": "保存调试快照 (interfaces.json + extracted_texts.json)",
      "help_en": "Save debug snapshots (interfaces.json + extracted_texts.json)",
      "section": null,
      "studio": { "editable": false }
    },
    {
      "flag": "--plugin-batch-size",
      "short": null,
      "dest": "plugin_batch_size",
      "type": "int",
      "default": null,
      "help_zh": "插件处理批次大小（-1=不分批，默认取自 env.yaml）",
      "help_en": "Plugin batch size (-1=no split, default from env.yaml)",
      "section": "pipeline",
      "studio": { "editable": true, "field_type": "number" }
    },
    {
      "flag": "--max-steps",
      "short": null,
      "dest": "max_steps",
      "type": "int",
      "default": null,
      "help_zh": "最大智能体步数（默认取自 env.yaml）",
      "help_en": "Max agent steps (default from env.yaml)",
      "section": "pipeline",
      "studio": { "editable": true, "field_type": "number" }
    },
    {
      "flag": "--max-retries",
      "short": null,
      "dest": "max_retries",
      "type": "int",
      "default": null,
      "help_zh": "LLM 调用最大重试次数（默认取自 env.yaml）",
      "help_en": "Max LLM call retries (default from env.yaml)",
      "section": "pipeline",
      "studio": { "editable": true, "field_type": "number" }
    },
    {
      "flag": "--skeleton-batch-size",
      "short": null,
      "dest": "skeleton_batch_size",
      "type": "int",
      "default": null,
      "help_zh": "骨架生成分批大小（默认取自 env.yaml）",
      "help_en": "Skeleton batch size (default from env.yaml)",
      "section": "pipeline",
      "studio": { "editable": true, "field_type": "number" }
    },
    {
      "flag": "--plan-single-batch-size",
      "short": null,
      "dest": "plan_single_batch_size",
      "type": "int",
      "default": null,
      "help_zh": "单接口测试点分组大小（默认取自 env.yaml）",
      "help_en": "Single API batch size (default from env.yaml)",
      "section": "pipeline",
      "studio": { "editable": true, "field_type": "number" }
    },
    {
      "flag": "--url-doc-match-max-retries",
      "short": null,
      "dest": "url_doc_match_max_retries",
      "type": "int",
      "default": null,
      "help_zh": "URL 文档匹配纠错重试次数（默认取自 env.yaml）",
      "help_en": "URL doc-match correction retries (default from env.yaml)",
      "section": "validation",
      "studio": { "editable": true, "field_type": "number" }
    },
    {
      "flag": "--url-doc-match-strategy",
      "short": null,
      "dest": "url_doc_match_strategy",
      "type": "str",
      "choices": ["fail", "warn", "skip"],
      "default": null,
      "help_zh": "URL 文档匹配纠错策略（默认取自 env.yaml）: fail | warn | skip",
      "help_en": "URL doc-match correction strategy (default from env.yaml): fail | warn | skip",
      "section": "validation",
      "studio": { "editable": true, "field_type": "select" }
    },
    {
      "flag": "--consecutive-batch-failure-limit",
      "short": null,
      "dest": "consecutive_batch_failure_limit",
      "type": "int",
      "default": null,
      "help_zh": "连续批次失败上限（默认取自 env.yaml）",
      "help_en": "Consecutive batch failure limit (default from env.yaml)",
      "section": "pipeline",
      "studio": { "editable": true, "field_type": "number" }
    },
    {
      "flag": "--url-doc-match-enabled",
      "short": null,
      "dest": "url_doc_match_enabled",
      "type": "bool_store_true",
      "default": null,
      "help_zh": "启用 URL 文档匹配校验",
      "help_en": "Enable URL doc-match validation",
      "section": "validation",
      "studio": { "editable": true, "field_type": "switch" }
    },
    {
      "flag": "--no-url-doc-match-enabled",
      "short": null,
      "dest": "no_url_doc_match_enabled",
      "type": "bool_store_true",
      "default": null,
      "help_zh": "禁用 URL 文档匹配校验",
      "help_en": "Disable URL doc-match validation",
      "section": "validation",
      "studio": { "editable": false }
    },
    {
      "flag": "--plugins",
      "short": null,
      "dest": "plugins",
      "type": "bool_store_true",
      "default": null,
      "help_zh": "启用插件系统",
      "help_en": "Enable plugin system",
      "section": "plugins",
      "studio": { "editable": true, "field_type": "switch" }
    },
    {
      "flag": "--no-plugins",
      "short": null,
      "dest": "no_plugins",
      "type": "bool_store_true",
      "default": null,
      "help_zh": "禁用插件系统",
      "help_en": "Disable plugin system",
      "section": "plugins",
      "studio": { "editable": false }
    },
    {
      "flag": "--skills",
      "short": null,
      "dest": "skills",
      "type": "bool_store_true",
      "default": null,
      "help_zh": "启用 Skill 注入",
      "help_en": "Enable skill injection",
      "section": "skills",
      "studio": { "editable": true, "field_type": "switch" }
    },
    {
      "flag": "--no-skills",
      "short": null,
      "dest": "no_skills",
      "type": "bool_store_true",
      "default": null,
      "help_zh": "禁用 Skill 注入",
      "help_en": "Disable skill injection",
      "section": "skills",
      "studio": { "editable": false }
    },
    {
      "flag": "--lang",
      "short": null,
      "dest": "lang",
      "type": "str",
      "default": null,
      "help_zh": "界面语言（zh_CN / en_US，默认取自 env.yaml）",
      "help_en": "UI language (zh_CN / en_US, default from env.yaml)",
      "section": null,
      "studio": { "editable": false }
    },
    {
      "flag": "--prompt",
      "short": "-p",
      "dest": "prompt",
      "type": "str",
      "default": null,
      "help_zh": "用户补充指导，注入到计划和用例生成提示词中",
      "help_en": "User guidance injected into planning and case-generation prompts",
      "section": null,
      "studio": { "editable": false }
    },
    {
      "flag": "--env",
      "short": null,
      "dest": "env",
      "type": "str",
      "default": "env.yaml",
      "help_zh": "配置文件路径（默认: env.yaml）",
      "help_en": "Path to config YAML file (default: env.yaml)",
      "section": null,
      "studio": { "editable": false }
    },
    {
      "flag": "--verbose",
      "short": "-v",
      "dest": "verbose",
      "type": "bool_store_true",
      "default": false,
      "help_zh": "启用详细控制台日志",
      "help_en": "Enable verbose console logging",
      "section": null,
      "studio": { "editable": false }
    },
    {
      "flag": "--debug",
      "short": null,
      "dest": "debug",
      "type": "bool_store_true",
      "default": false,
      "help_zh": "启用调试日志（完整 LLM I/O 写入 session debug.log）",
      "help_en": "Enable debug logging (full LLM I/O written to session debug.log)",
      "section": null,
      "studio": { "editable": false }
    },
    {
      "flag": "--parse-mode",
      "short": "-m",
      "dest": "parse_mode",
      "type": "str",
      "choices": ["llm", "rule"],
      "default": "llm",
      "help_zh": "API 文档解析模式 (default: llm): llm=LLM预提取接口, rule=规则解析器(OpenAPI/Markdown)",
      "help_en": "API doc parse mode (default: llm): llm=LLM pre-extraction, rule=rule-based parser (OpenAPI/Markdown)",
      "section": null,
      "studio": { "editable": false }
    },
    {
      "flag": "--parser-path",
      "short": null,
      "dest": "parser_path",
      "type": "str",
      "default": null,
      "help_zh": "自定义解析器 .py 路径（仅 --parse-mode rule）",
      "help_en": "Custom parser .py path (only for --parse-mode rule)",
      "section": null,
      "studio": { "editable": false }
    },
    {
      "flag": "--reference-dir",
      "short": null,
      "dest": "reference_dir",
      "type": "str",
      "default": null,
      "help_zh": "增量更新参考目录",
      "help_en": "Reference directory for incremental updates",
      "section": null,
      "studio": { "editable": false }
    },
    {
      "flag": "--resume",
      "short": null,
      "dest": "resume",
      "type": "bool_store_true",
      "default": false,
      "help_zh": "从已有 output 目录恢复执行",
      "help_en": "Resume from existing output directory",
      "section": null,
      "studio": { "editable": false }
    },
    {
      "flag": "--resume-overwrite",
      "short": null,
      "dest": "resume_overwrite",
      "type": "bool_store_true",
      "default": false,
      "help_zh": "恢复时覆盖已有输出",
      "help_en": "Overwrite existing output when resuming",
      "section": null,
      "studio": { "editable": false }
    },
    {
      "flag": "--auto",
      "short": null,
      "dest": "auto",
      "type": "bool_store_true",
      "default": false,
      "help_zh": "自动模式：跳过所有人工审核，适合夜间批量生成",
      "help_en": "Auto mode: skip all human review, suitable for nightly batch generation",
      "section": "pipeline",
      "studio": { "editable": true, "field_type": "switch" }
    },
    {
      "flag": "--case-type",
      "short": null,
      "dest": "case_type",
      "type": "str",
      "choices": ["single", "biz", "both"],
      "default": null,
      "help_zh": "用例生成类型: single=仅单接口, biz=仅业务链路, both=全部（默认）",
      "help_en": "Case type: single=API only, biz=flow only, both=all (default)",
      "section": "pipeline",
      "studio": { "editable": true, "field_type": "select" }
    },
    {
      "flag": "--log-to-output",
      "short": null,
      "dest": "log_to_output",
      "type": "bool_store_true",
      "default": null,
      "help_zh": "将日志持久化到输出目录 ({output_dir}/logs/agent.log)",
      "help_en": "Persist logs to output dir ({output_dir}/logs/agent.log)",
      "section": "logging",
      "studio": { "editable": true, "field_type": "switch" }
    },
    {
      "flag": "--studio",
      "short": null,
      "dest": "studio",
      "type": "bool_store_true",
      "default": false,
      "help_zh": "Studio 子进程模式（JSON 协议通信）",
      "help_en": "Studio subprocess mode (JSON protocol)",
      "section": null,
      "studio": { "editable": false }
    },
    {
      "flag": "--plugin-module",
      "short": null,
      "dest": "plugin_module",
      "type": "str",
      "action": "append",
      "default": null,
      "help_zh": "插件模块路径（可重复，覆盖 env.yaml 中的 plugins.modules）",
      "help_en": "Plugin module path (repeatable, overrides plugins.modules in env.yaml)",
      "section": "plugins",
      "studio": { "editable": false }
    },
    {
      "flag": "--case-gen-validation-rule",
      "short": null,
      "dest": "case_gen_validation_rule",
      "type": "str",
      "action": "append",
      "default": null,
      "help_zh": "用例生成校验规则（可重复，格式: check:strategy[:failure_action]，例 --case-gen-validation-rule url_check:skip:keep）",
      "help_en": "Case gen validation rule (repeatable, format: check:strategy[:failure_action], e.g. --case-gen-validation-rule url_check:skip:keep)",
      "section": "validation",
      "studio": { "editable": false }
    },
    {
      "flag": "--case-gen-validation-max-retries",
      "short": null,
      "dest": "case_gen_validation_max_retries",
      "type": "int",
      "default": null,
      "help_zh": "用例生成校验最大重试次数（默认取自 env.yaml）",
      "help_en": "Case gen validation max retries (default from env.yaml)",
      "section": "validation",
      "studio": { "editable": true, "field_type": "number" }
    },
    {
      "flag": "--skill-agent",
      "short": null,
      "dest": "skill_agent",
      "type": "str",
      "action": "append",
      "default": null,
      "help_zh": "Skill 代理映射（可重复，格式: agent_name:skill1,skill2，例 --skill-agent data_filler:foli_mall_data_filling）",
      "help_en": "Skill agent mapping (repeatable, format: agent_name:skill1,skill2, e.g. --skill-agent data_filler:foli_mall_data_filling)",
      "section": "skills",
      "studio": { "editable": false }
    }
  ]
}
