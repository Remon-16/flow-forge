          "studio": { "editable": true, "field_type": "text" }
        },
        {
          "flag": "--biz-flows",
          "short": null,
          "dest": "biz_flows",
          "type": "str",
          "help_zh": "业务链路 YAML 文件目录",
          "help_en": "Directory containing biz flow YAML files",
          "studio": { "editable": true, "field_type": "text" }
        },
        {
          "flag": "--output",
          "short": "-o",
          "dest": "output",
          "type": "str",
          "required": true,
          "help_zh": "pytest 输出目录",
          "help_en": "Output directory for pytest files",
          "studio": { "editable": true, "field_type": "text" }
        },
        {
          "flag": "--config-dir",
          "short": null,
          "dest": "config_dir",
          "type": "str",
          "help_zh": "env-*.yml 配置文件目录（默认: python/）",
          "help_en": "Directory containing env-*.yml files (default: python/)",
          "studio": { "editable": true, "field_type": "text" }
