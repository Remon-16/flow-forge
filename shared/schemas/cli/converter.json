{
  "entry": "converter",
  "description_zh": "Flow Forge — 测试用例格式转换器（Excel ↔ YAML）",
  "description_en": "Flow Forge — Test Case Format Converter (Excel ↔ YAML)",
  "flag_style": "camelCase",
  "subcommands": {
    "excel2yaml": {
      "description_zh": "Excel (.xlsx) → YAML 目录",
      "description_en": "Convert Excel (.xlsx) → YAML directory",
      "args": [
        {
          "flag": "--input",
          "short": "-i",
          "dest": "input",
          "type": "str",
          "required": true,
          "help_zh": "输入 .xlsx 文件路径",
          "help_en": "Input .xlsx file path",
          "studio": { "editable": true, "field_type": "text" }
        },
        {
          "flag": "--output",
          "short": "-o",
          "dest": "output",
          "type": "str",
          "required": true,
          "help_zh": "YAML 输出目录",
          "help_en": "Output directory for YAML files",
          "studio": { "editable": true, "field_type": "text" }
        },
        {
          "flag": "--verbose",
          "short": "-v",
          "dest": "verbose",
          "type": "bool_store_true",
          "default": false,
          "help_zh": "启用调试日志",
          "help_en": "Enable debug logging",
          "studio": { "editable": false }
        }
      ]
    },
    "yaml2excel": {
      "description_zh": "YAML 目录 → Excel (.xlsx)",
      "description_en": "Convert YAML directories → Excel (.xlsx)",
      "args": [
        {
          "flag": "--interfaces",
          "short": null,
          "dest": "interfaces",
          "type": "str",
          "help_zh": "接口 YAML 文件目录",
          "help_en": "Directory containing interface YAML files",
          "studio": { "editable": true, "field_type": "text" }
        },
        {
          "flag": "--single-cases",
          "short": null,
          "dest": "single_cases",
          "type": "str",
          "help_zh": "单接口用例 YAML 文件目录",
          "help_en": "Directory containing single case YAML files",
          "studio": { "editable": true, "field_type": "text" }
        },
        {
          "flag": "--biz-flows",
          "short": null,
          "dest": "biz_flows",
          "type": "str",
          "help_zh": "业务链路 YAML 文件目录",
          "help_en": "Directory containing biz flow YAML files",
          "studio": { "editable": true, "field_type": "text" }
        },
        {
          "flag": "--output",
          "short": "-o",
          "dest": "output",
          "type": "str",
          "required": true,
          "help_zh": "输出 .xlsx 文件路径",
          "help_en": "Output .xlsx file path",
          "studio": { "editable": true, "field_type": "text" }
        },
        {
          "flag": "--verbose",
          "short": "-v",
          "dest": "verbose",
          "type": "bool_store_true",
          "default": false,
          "help_zh": "启用调试日志",
          "help_en": "Enable debug logging",
          "studio": { "editable": false }
        }
      ]
    },
    "yaml2pytest": {
      "description_zh": "YAML 目录 → pytest 测试文件",
      "description_en": "Convert YAML directories → pytest test files",
      "args": [
        {
          "flag": "--interfaces",
          "short": null,
          "dest": "interfaces",
          "type": "str",
          "help_zh": "接口 YAML 文件目录",
