          "type": "str",
          "help_zh": "自定义处理器目录",
          "help_en": "Directory containing custom processors",
          "studio": { "editable": true, "field_type": "text" }
        },
        {
          "flag": "--verbose",
          "short": "-v",
          "dest": "verbose",
          "type": "bool_store_true",
          "default": false,
          "help_zh": "启用调试日志",
          "help_en": "Enable debug logging",
          "studio": { "editable": false }
        }
      ]
    },
    "excel2pytest": {
      "description_zh": "Excel (.xlsx) → pytest 测试文件",
